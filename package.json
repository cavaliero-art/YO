{
  "name": "yo",
  "productName": "YO",
  "version": "0.11.3",
  "description": "YO: a small desktop companion that hangs from the top of your screen and does quick things for you.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/make-icons.js",
    "promo": "electron promo/render.js",
    "dist": "electron-builder --win nsis --publish never",
    "test": "node --test --test-force-exit tests/agent.test.js tests/unlocks.test.js tests/miniapps.test.js tests/todo.test.js tests/prayer.test.js tests/customize.test.js tests/habits.test.js tests/backup.test.js tests/updater.test.js",
    "film": "electron promo/film.js"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "cavaliero-art",
  "build": {
    "appId": "com.cavaliero.yo",
    "productName": "YO",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "main/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "YO",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "YO-Setup-${version}.${ext}"
    },
    "extraFiles": [
      "LICENSE",
      "PRIVACY.md"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "cavaliero-art",
        "repo": "YO",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
